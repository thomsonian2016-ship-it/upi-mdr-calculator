---
import Base from "../../layouts/Base.astro";
import Calculator from "../../components/Calculator.astro";
import { SITE, LAST_UPDATED_ISO, OFFICIAL_FAQ_URL, calc, inr, inr0, faqSchema, breadcrumbSchema, type Faq } from "../../lib/mdr";

const title = "UPI MDR कैलकुलेटर – यूपीआई चार्ज का नया नियम 2026";
const description = "UPI पर कितना चार्ज लगेगा? 15 अक्टूबर 2026 से ₹2,000 से ऊपर के मर्चेंट पेमेंट पर 0.4% MDR। राशि डालें और देखें MDR, GST और दुकानदार को कितना मिलेगा।";

const examples = [1500, 2000, 3000, 5000, 10000, 25000, 50000, 75000, 100000].map(calc);

const faqs: Faq[] = [
  { q: "यूपीआई एमडीआर क्या है?", a: "MDR का पूरा नाम मर्चेंट डिस्काउंट रेट है। यह वह शुल्क है जो दुकानदार या व्यापारी अपने बैंक या पेमेंट प्रोवाइडर को डिजिटल पेमेंट स्वीकार करने पर देता है। 15 अक्टूबर 2026 से ₹2,000 से ऊपर के UPI मर्चेंट पेमेंट पर 0.4% MDR लगेगा, अधिकतम ₹300।" },
  { q: "क्या यूपीआई पेमेंट पर चार्ज लगेगा?", a: "ग्राहक के लिए नहीं। दुकान पर पेमेंट, QR स्कैन या किसी को पैसे भेजने पर ग्राहक को कोई अतिरिक्त चार्ज नहीं देना होगा। चार्ज सिर्फ़ मर्चेंट को ₹2,000 से ऊपर के पेमेंट पर देना होगा।" },
  { q: "UPI पर नया MDR चार्ज कब से लागू होगा?", a: "नया MDR नियम 15 अक्टूबर 2026 से लागू होगा। NPCI ने इसकी घोषणा 15 सितंबर 2026 को की थी।" },
  { q: "क्या ग्राहकों के लिए UPI अब भी मुफ़्त है?", a: "हाँ। MDR मर्चेंट से लिया जाने वाला शुल्क है। UPI से पेमेंट करने वाले ग्राहक को कुछ भी अतिरिक्त नहीं देना होगा, और व्यक्ति से व्यक्ति (P2P) ट्रांसफर मुफ़्त रहेंगे।" },
  { q: "किन UPI पेमेंट पर MDR लगेगा?", a: "₹2,000 से ज़्यादा के मर्चेंट (P2M) UPI पेमेंट पर 0.4% MDR लगेगा। ₹2,000 या उससे कम के पेमेंट पर कोई MDR नहीं है।" },
  { q: "एक पेमेंट पर अधिकतम कितना MDR लग सकता है?", a: "एक पेमेंट पर MDR की अधिकतम सीमा ₹300 है, जो ₹75,000 के पेमेंट पर पहुँचती है। 18% GST मिलाकर अधिकतम कुल कटौती ₹354 है।" },
  { q: "क्या छोटे दुकानदारों को MDR से छूट है?", a: "हाँ। जिन छोटे मर्चेंट को UPI QR कोड से महीने में ₹1 लाख तक का पेमेंट मिलता है, उन्हें ₹2,000 से ऊपर के पेमेंट पर भी कोई MDR नहीं देना होगा। इसके लिए GST रजिस्ट्रेशन ज़रूरी नहीं है। लगातार 3 महीने ₹1 लाख से ज़्यादा पेमेंट आने पर ही मर्चेंट सामान्य कैटेगरी में जाएगा।" },
  { q: "किन सेक्टर पर फ्लैट ₹5 MDR लगेगा?", a: "रेलवे, टेलीकॉम, बीमा, ईंधन, बिजली-पानी-पाइप गैस के बिल और शिक्षण संस्थानों में ₹2,000 से ऊपर के पेमेंट पर 0.4% की जगह फ्लैट ₹5 MDR लगेगा।" },
  { q: "म्यूचुअल फंड और शेयर ब्रोकर के लिए UPI MDR कितना है?", a: "कैपिटल मार्केट पेमेंट, जैसे म्यूचुअल फंड और ब्रोकर को पेमेंट, पर 0.02% MDR लगेगा, अधिकतम ₹300।" },
  { q: "क्या UPI ऑटोपे पर MDR लगेगा?", a: "नहीं। सब्सक्रिप्शन, बिल और SIP के लिए इस्तेमाल होने वाले UPI मैंडेट या ऑटोपे पर कोई तय MDR नहीं है।" },
  { q: "क्या UPI MDR पर GST लगता है?", a: "MDR एक बैंक सर्विस शुल्क है, जिस पर आमतौर पर 18% GST लगता है, वह भी सिर्फ़ शुल्क पर, पूरी राशि पर नहीं। ₹5,000 के पेमेंट पर MDR ₹20 और GST ₹3.60 होगा। GST रजिस्टर्ड मर्चेंट इसे इनपुट टैक्स क्रेडिट के रूप में क्लेम कर सकते हैं। सरकारी FAQ में GST का ज़िक्र नहीं है, इसलिए कैलकुलेटर में GST बंद करने का विकल्प है।" },
  { q: "क्या दुकानदार MDR का पैसा ग्राहक से ले सकता है?", a: "नहीं। बैंकों और पेमेंट प्रोवाइडर को निर्देश दिया गया है कि मर्चेंट MDR ग्राहक पर न डालें। MDR मर्चेंट के सेटलमेंट से काटा जाता है।" },
];

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "UPI MDR कैलकुलेटर",
    url: SITE + "/hi/",
    description,
    applicationCategory: "FinanceApplication",
    operatingSystem: "All",
    inLanguage: "hi-IN",
    dateModified: LAST_UPDATED_ISO,
    offers: { "@type": "Offer", price: "0", priceCurrency: "INR" },
  },
  faqSchema(faqs),
  breadcrumbSchema([
    { name: "UPI MDR Calculator", url: SITE + "/" },
    { name: "हिंदी", url: SITE + "/hi/" },
  ]),
];
---

<Base title={title} description={description} path="/hi/" lang="hi" alternates={{ en: "/", hi: "/hi/" }} schemas={schemas}>
  <header class="page-head">
    <h1>UPI चार्ज कैलकुलेटर</h1>
    <p class="sub">UPI MDR कैलकुलेटर: UPI पर कितना चार्ज लगेगा, तुरंत जानें</p>
    <p class="lead"><strong>15 अक्टूबर 2026</strong> से लागू नए नियमों के अनुसार देखें कि किसी भी UPI पेमेंट पर कितना MDR, कितना GST कटेगा और मर्चेंट को कितना पैसा मिलेगा।</p>
  </header>

  <Calculator lang="hi" />

  <p class="updated center">अंतिम अपडेट: 26 सितंबर 2026। यह NPCI के MDR नियमों और <a href={OFFICIAL_FAQ_URL} rel="noopener">वित्तीय सेवा विभाग के आधिकारिक FAQ</a> पर आधारित है। अपने सटीक शुल्क के लिए अपने बैंक या पेमेंट प्रोवाइडर से पुष्टि करें।</p>

  <article class="prose">
    <h2>यूपीआई चार्ज का नया नियम: 15 अक्टूबर 2026 से क्या बदलेगा</h2>
    <p>
      MDR (मर्चेंट डिस्काउंट रेट) वह शुल्क है जो दुकानदार या व्यापारी डिजिटल पेमेंट स्वीकार करने पर देता है। कई सालों से UPI पर कोई MDR नहीं था। <strong>15 अक्टूबर 2026</strong> से NPCI के नए नियम में बड़े मर्चेंट पेमेंट पर थोड़ा MDR जोड़ा गया है। ग्राहक पहले जितना ही पैसा देगा; शुल्क मर्चेंट को मिलने वाली राशि से कटेगा।
    </p>

    <h3>UPI पर कितना चार्ज लगेगा: नियम एक नज़र में</h3>
    <ul>
      <li><strong>₹2,000 या कम:</strong> कोई MDR नहीं।</li>
      <li><strong>₹2,000 से ज़्यादा:</strong> 0.4% MDR, एक पेमेंट पर अधिकतम ₹300 (₹75,000 पर सीमा पूरी)।</li>
      <li><strong>रियायती सेक्टर</strong> (रेलवे, टेलीकॉम, बीमा, ईंधन, बिजली-पानी-गैस बिल, शिक्षण संस्थान): ₹2,000 से ऊपर फ्लैट ₹5 MDR।</li>
      <li><strong>म्यूचुअल फंड और शेयर ब्रोकर:</strong> 0.02% MDR, अधिकतम ₹300।</li>
      <li><strong>UPI ऑटोपे:</strong> कोई तय MDR नहीं।</li>
      <li><strong>RuPay क्रेडिट कार्ड से UPI:</strong> अलग नियम, कार्ड वाली दरें लागू। <a href="/rupay-credit-card-upi-charges/">विवरण (अंग्रेज़ी में)</a></li>
      <li><strong>छोटे मर्चेंट</strong> जिन्हें UPI QR से महीने में ₹1 लाख तक मिलता है: कोई MDR नहीं।</li>
      <li><strong>व्यक्ति से व्यक्ति ट्रांसफर (P2P):</strong> हमेशा मुफ़्त। ग्राहकों के लिए UPI मुफ़्त है, <a href="/is-upi-free/">यहाँ पढ़ें</a>।</li>
      <li><strong>GST:</strong> 18%, सिर्फ़ MDR शुल्क पर, पूरी राशि पर नहीं।</li>
    </ul>

    <h3>हिसाब कैसे लगाएं</h3>
    <p>
      MDR = पेमेंट × 0.4% (अधिकतम ₹300)। GST = MDR × 18%। मर्चेंट को मिलेगा = पेमेंट − MDR − GST।
      उदाहरण: ₹10,000 के पेमेंट पर MDR ₹40, GST ₹7.20, और मर्चेंट को ₹9,952.80 मिलेंगे।
    </p>

    <h3>सामान्य मर्चेंट के लिए UPI MDR उदाहरण</h3>
    <div class="table-wrap">
      <table>
        <thead><tr><th>पेमेंट</th><th>MDR</th><th>GST (18%)</th><th>मर्चेंट को मिलेगा</th></tr></thead>
        <tbody>
          {examples.map((e) => (
            <tr><td>{inr0(e.amount)}</td><td>{inr(e.mdr)}</td><td>{inr(e.gst)}</td><td>{inr(e.net)}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>₹2,000 से ₹1 लाख तक हर राशि के लिए पूरा <a href="/upi-charges-chart/">UPI चार्ज चार्ट</a> देखें (अंग्रेज़ी में)।</p>
    <p lang="en">This calculator is also available <a href="/">in English</a>.</p>

    <h2>दुकानदारों के लिए और जानकारी</h2>
    <ul>
      <li><a href="/what-is-mdr/">MDR क्या होता है?</a> पूरा नाम, मतलब और P2PM बनाम P2M</li>
      <li><a href="/soundbox-charges/">साउंडबॉक्स चार्ज</a>: PhonePe, Google Pay और Paytm का महीने का किराया</li>
      <li><a href="/is-upi-free/">क्या UPI ग्राहकों के लिए फ्री है?</a></li>
      <li><a href="/upi-vs-card-charges/">UPI बनाम डेबिट/क्रेडिट कार्ड चार्ज</a> (अंग्रेज़ी में)</li>
    </ul>

    <h2>अक्सर पूछे जाने वाले सवाल</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details><summary>{f.q}</summary><p>{f.a}</p></details>
      ))}
    </div>
  </article>
</Base>

<style>
  .page-head { text-align: center; margin-bottom: 20px; }
  .center { text-align: center; margin-top: 14px; }
  .sub { margin: 0 0 6px; font-weight: 600; color: var(--muted); }
</style>
