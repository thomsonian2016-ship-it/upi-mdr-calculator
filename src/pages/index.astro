---
import Base from "../layouts/Base.astro";
import Calculator from "../components/Calculator.astro";
import { SITE, LAST_UPDATED, LAST_UPDATED_ISO, calc, inr, inr0, faqSchema, type Faq } from "../lib/mdr";

const title = "UPI MDR Calculator 2026 – MDR Charges, GST & Net Settlement";
const description = "Free UPI MDR calculator for the rules from 15 Oct 2026. Enter any UPI payment to see the 0.4% MDR, 18% GST and how much the merchant actually receives.";

const examples = [1500, 2000, 3000, 5000, 10000, 25000, 50000, 75000, 100000].map(calc);

const faqs: Faq[] = [
  { q: "When do the new UPI MDR charges start?", a: "The new MDR framework applies from 15 October 2026. It was announced by NPCI on 15 September 2026." },
  { q: "Is UPI still free for customers?", a: "Yes. MDR is a merchant-side fee. Customers paying by UPI are not charged anything extra, and person-to-person (P2P) transfers remain free." },
  { q: "Which UPI payments attract MDR?", a: "Person-to-merchant (P2M) UPI payments above ₹2,000 attract 0.4% MDR. Payments of ₹2,000 or less have zero MDR." },
  { q: "What is the maximum UPI MDR on one payment?", a: "MDR is capped at ₹300 per transaction, which is reached at ₹75,000. With 18% GST on the MDR, the maximum total deduction is ₹354." },
  { q: "Are small merchants exempt from UPI MDR?", a: "Yes. Small merchants receiving up to ₹1 lakh a month through UPI QR codes continue to pay zero MDR, even on payments above ₹2,000." },
  { q: "Which sectors pay a flat ₹5 MDR?", a: "Reported essential sectors — railways, telecom, insurance, fuel and agricultural inputs — pay a flat ₹5 MDR on payments above ₹2,000 instead of 0.4%." },
  { q: "Is GST charged on UPI MDR?", a: "Yes, 18% GST applies to the MDR fee, not to the payment amount. On a ₹5,000 payment, MDR is ₹20 and GST is ₹3.60. GST-registered merchants can usually claim this as input tax credit. The GST rate on MDR may be reviewed by the GST Council." },
  { q: "Can a merchant charge customers extra to cover MDR?", a: "No. Banks and payment providers have been directed to ensure merchants do not pass MDR on to customers. The MDR is deducted from the merchant's settlement." },
];

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "UPI MDR Calculator",
    url: SITE + "/",
    inLanguage: ["en-IN", "hi-IN"],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "UPI MDR Calculator",
    url: SITE + "/",
    description,
    applicationCategory: "FinanceApplication",
    operatingSystem: "All",
    inLanguage: "en-IN",
    dateModified: LAST_UPDATED_ISO,
    offers: { "@type": "Offer", price: "0", priceCurrency: "INR" },
  },
  faqSchema(faqs),
];
---

<Base title={title} description={description} path="/" lang="en" alternates={{ en: "/", hi: "/hi/" }} schemas={schemas}>
  <header class="page-head">
    <h1>UPI MDR Calculator</h1>
    <p class="lead">See the MDR, GST and net amount a merchant receives on any UPI payment under the new rules from <strong>15 October 2026</strong>.</p>
  </header>

  <Calculator lang="en" />

  <p class="updated center">Last updated {LAST_UPDATED}. Based on the NPCI MDR framework announced on 15 September 2026. Check your exact charges with your bank or payment provider.</p>

  <article class="prose">
    <h2>How UPI MDR works from 15 October 2026</h2>
    <p>
      MDR (Merchant Discount Rate) is the fee a merchant pays for accepting a digital payment. UPI had zero MDR for years. From <strong>15 October 2026</strong>, NPCI's new framework adds a small MDR on larger person-to-merchant (P2M) UPI payments. The customer still pays the normal price; the fee is deducted from what the merchant receives.
    </p>

    <h3>The rules at a glance</h3>
    <ul>
      <li><strong>₹2,000 or less:</strong> zero MDR.</li>
      <li><strong>Above ₹2,000:</strong> 0.4% MDR, capped at ₹300 per payment (the cap is reached at ₹75,000).</li>
      <li><strong>Essential sectors</strong> (railways, telecom, insurance, fuel, agricultural inputs): flat ₹5 MDR above ₹2,000.</li>
      <li><strong>Small merchants</strong> receiving up to ₹1 lakh a month via UPI QR: zero MDR.</li>
      <li><strong>Person-to-person transfers:</strong> always free.</li>
      <li><strong>GST:</strong> 18% on the MDR fee only, not on the payment amount.</li>
    </ul>
    <p>Read the full breakdown in our <a href="/upi-mdr-rules-2026/">UPI MDR rules 2026 guide</a>.</p>

    <h3>How the calculation works</h3>
    <p>
      MDR = payment × 0.4% (maximum ₹300). GST = MDR × 18%. Merchant receives = payment − MDR − GST.
      For a ₹10,000 payment: MDR is ₹40, GST is ₹7.20, and the merchant receives ₹9,952.80.
    </p>

    <h3>UPI MDR examples for a standard merchant</h3>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Payment</th><th>MDR</th><th>GST (18%)</th><th>Merchant receives</th></tr></thead>
        <tbody>
          {examples.map((e) => (
            <tr><td>{inr0(e.amount)}</td><td>{inr(e.mdr)}</td><td>{inr(e.gst)}</td><td>{inr(e.net)}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>Need a specific amount? See the full <a href="/upi-mdr-chart/">UPI MDR chart from ₹2,000 to ₹1 lakh</a>.</p>
    <p lang="hi">यह कैलकुलेटर <a href="/hi/">हिंदी में</a> भी उपलब्ध है।</p>

    <h2>Frequently asked questions</h2>
    <div class="faq">
      {faqs.map((f) => (
        <details><summary>{f.q}</summary><p>{f.a}</p></details>
      ))}
    </div>
  </article>
</Base>

<style>
  .page-head { text-align: center; margin-bottom: 20px; }
  .center { text-align: center; margin-top: 14px; }
</style>
